{
  "name": "multi-app-bug-tracker",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-Application Mobile-Friendly Bug Tracker with React & Google Sheets",
  "scripts": {
    "pdf": "node scripts/generate_setup_pdf.js",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  }
}
