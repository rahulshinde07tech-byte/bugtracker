# Server Port
PORT=5000

# Google Sheets Configuration (Required - All data is stored in Google Sheets)
# 1. Your Google Spreadsheet ID (from spreadsheet URL: https://docs.google.com/spreadsheets/d/[SHEET_ID]/edit)
GOOGLE_SHEET_ID=

# 2. Option A: Service Account Credentials directly in .env
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# 2. Option B: Alternative - Path to downloaded Service Account JSON key file
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json
